                "    Selected = Table.SelectColumns(Data, {\"WeekStart\", \"ActualSales\", \"PredictedSales\", \"LowerBound\", \"UpperBound\"})",
                "in",
                "    Selected"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Actual Sales",
