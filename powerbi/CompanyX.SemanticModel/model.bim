{
  "name": "CompanyX",
  "compatibilityLevel": 1600,
  "model": {
    "culture": "en-US",
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "tables": [
      {
        "name": "FactSales",
        "columns": [
          {
            "name": "SalesOrderDetailID",
            "dataType": "int64",
            "sourceColumn": "SalesOrderDetailID",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "SalesOrderID",
            "dataType": "int64",
            "sourceColumn": "SalesOrderID",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "SalesDateKey",
            "dataType": "int64",
            "sourceColumn": "SalesDateKey",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "ProductKey",
            "dataType": "int64",
            "sourceColumn": "ProductKey",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "CustomerKey",
            "dataType": "int64",
            "sourceColumn": "CustomerKey",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "SalesPersonKey",
            "dataType": "int64",
            "sourceColumn": "SalesPersonKey",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "TerritoryKey",
            "dataType": "int64",
            "sourceColumn": "TerritoryKey",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "PromotionKey",
            "dataType": "int64",
            "sourceColumn": "PromotionKey",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "OrderQty",
            "dataType": "int64",
            "sourceColumn": "OrderQty",
            "summarizeBy": "none"
          },
          {
            "name": "NetSales",
            "dataType": "double",
            "sourceColumn": "NetSales",
            "summarizeBy": "none"
          },
          {
            "name": "EstimatedCost",
            "dataType": "double",
            "sourceColumn": "EstimatedCost",
            "summarizeBy": "none"
          },
          {
            "name": "EstimatedGrossProfit",
            "dataType": "double",
            "sourceColumn": "EstimatedGrossProfit",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "FactSales",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Sql.Database(\"localhost\", \"CompanyX_BI_DW\", [CreateNavigationProperties=false]),",
                "    Data = Source{[Schema=\"mart\",Item=\"Sales\"]}[Data],",
                "    Selected = Table.SelectColumns(Data, {\"SalesOrderDetailID\", \"SalesOrderID\", \"SalesDateKey\", \"ProductKey\", \"CustomerKey\", \"SalesPersonKey\", \"TerritoryKey\", \"PromotionKey\", \"OrderQty\", \"NetSales\", \"EstimatedCost\", \"EstimatedGrossProfit\"})",
                "in",
                "    Selected"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Net Sales",
            "expression": "SUM(FactSales[NetSales])",
            "formatString": "#,0.00"
          },
          {
            "name": "Quantity",
            "expression": "SUM(FactSales[OrderQty])",
            "formatString": "#,0"
          },
          {
            "name": "Total Orders",
            "expression": "DISTINCTCOUNT(FactSales[SalesOrderID])",
            "formatString": "#,0"
          },
          {
            "name": "AOV",
            "expression": "DIVIDE([Net Sales],[Total Orders])",
            "formatString": "#,0.00"
          },
          {
            "name": "ASP",
            "expression": "DIVIDE([Net Sales],[Quantity])",
            "formatString": "#,0.00"
          },
          {
            "name": "Estimated Gross Profit",
            "expression": "SUM(FactSales[EstimatedGrossProfit])",
            "formatString": "#,0.00"
          },
          {
            "name": "Cost Covered Sales",
            "expression": "CALCULATE([Net Sales],FILTER(FactSales,NOT ISBLANK(FactSales[EstimatedCost])))",
            "formatString": "#,0.00"
          },
          {
            "name": "Estimated Margin",
            "expression": "DIVIDE([Estimated Gross Profit],[Cost Covered Sales])",
            "formatString": "0.0%"
          },
          {
            "name": "Cost Coverage",
            "expression": "DIVIDE([Cost Covered Sales],[Net Sales])",
            "formatString": "0.0%"
          },
          {
            "name": "Sales Previous Year",
            "expression": "CALCULATE([Net Sales],DATEADD(DimDate[Date],-1,YEAR))",
            "formatString": "#,0.00"
          },
          {
            "name": "YoY Growth",
            "expression": "DIVIDE([Net Sales]-[Sales Previous Year],[Sales Previous Year])",
            "formatString": "0.0%"
          },
          {
            "name": "Sales Previous Month",
            "expression": "CALCULATE([Net Sales],DATEADD(DimDate[Date],-1,MONTH))",
            "formatString": "#,0.00"
          },
          {
            "name": "MoM Growth",
            "expression": "DIVIDE([Net Sales]-[Sales Previous Month],[Sales Previous Month])",
            "formatString": "0.0%"
          }
        ]
      },
