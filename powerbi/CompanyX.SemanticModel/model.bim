              "type": "m",
              "expression": [
                "let",
                "    Source = Sql.Database(\"localhost\", \"CompanyX_BI_DW\", [CreateNavigationProperties=false]),",
                "    Data = Source{[Schema=\"dw\",Item=\"DimDate\"]}[Data],",
                "    Selected = Table.SelectColumns(Data, {\"DateKey\", \"Date\", \"Year\", \"Quarter\", \"Month\", \"MonthName\", \"YearMonth\", \"WeekStart\", \"ISOWeek\", \"ISOYear\"})",
