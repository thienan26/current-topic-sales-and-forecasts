          },
          {
            "name": "N",
            "dataType": "int64",
            "sourceColumn": "N",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "ModelEvaluation",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Sql.Database(\"localhost\", \"CompanyX_BI_DW\", [CreateNavigationProperties=false]),",
                "    Data = Source{[Schema=\"mart\",Item=\"LatestModelEvaluation\"]}[Data],",
                "    Selected = Table.SelectColumns(Data, {\"ModelName\", \"EvaluationSet\", \"MAE\", \"RMSE\", \"WMAPE\", \"Bias\", \"IntervalCoverage\", \"N\"})",
                "in",
                "    Selected"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Holdout wMAPE",
            "expression": "CALCULATE(MAX(ModelEvaluation[WMAPE]),ModelEvaluation[EvaluationSet]=\"holdout\")",
            "formatString": "0.0%"
          },
          {
            "name": "Holdout Coverage",
            "expression": "CALCULATE(MAX(ModelEvaluation[IntervalCoverage]),ModelEvaluation[EvaluationSet]=\"holdout\")",
            "formatString": "0.0%"
          },
          {
            "name": "Holdout Bias",
            "expression": "CALCULATE(MAX(ModelEvaluation[Bias]),ModelEvaluation[EvaluationSet]=\"holdout\")",
            "formatString": "0.0%"
          }
        ]
      },
