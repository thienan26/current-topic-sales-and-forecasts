            "dataType": "string",
            "sourceColumn": "ReleaseStatus",
            "summarizeBy": "none"
          },
          {
            "name": "CreatedAt",
            "dataType": "dateTime",
            "sourceColumn": "CreatedAt",
            "summarizeBy": "none",
            "formatString": "dd MMM yyyy"
          }
        ],
        "partitions": [
          {
            "name": "Forecast",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Sql.Database(\"localhost\", \"CompanyX_BI_DW\", [CreateNavigationProperties=false]),",
                "    Data = Source{[Schema=\"mart\",Item=\"LatestForecast\"]}[Data],",
                "    Selected = Table.SelectColumns(Data, {\"ForecastRunKey\", \"WeekStart\", \"Horizon\", \"PredictedSales\", \"LowerBound\", \"UpperBound\", \"Champion\", \"ForecastOriginDate\", \"ReleaseStatus\", \"CreatedAt\"})",
                "in",
                "    Selected"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Model Status",
            "expression": "SELECTEDVALUE(Forecast[ReleaseStatus],\"NO FORECAST\")",
            "formatString": ""
          },
          {
            "name": "Champion",
            "expression": "SELECTEDVALUE(Forecast[Champion],\"NO MODEL\")",
            "formatString": ""
          },
          {
            "name": "Forecast Origin",
            "expression": "MAX(Forecast[ForecastOriginDate])",
            "formatString": "dd MMM yyyy"
          },
          {
            "name": "Eight Week Forecast",
            "expression": "SUM(Forecast[PredictedSales])",
            "formatString": "#,0.00"
          },
          {
            "name": "Planning Guidance",
            "expression": "IF([Model Status]=\"REVIEW_REQUIRED\",\"Review model and sales history before changing plans\",\"Review forecast with the sales planning team\")",
            "formatString": ""
          }
        ]
      },
      {
        "name": "ForecastChart",
